#!/usr/bin/env sh
set -eu

if [ "$#" -lt 3 ]; then
  echo "usage: app-singleton <app-id> <tag> <command...>" >&2
  exit 1
fi

APP_ID="$1"
TAG="$2"
shift 2
CMD="$@"

# If app already exists, just jump to its tag
if riverctl list-views | grep -q "app-id: $APP_ID"; then
  riverctl set-focused-tags "$TAG"
  exit 0
fi

# Otherwise spawn it and jump to the tag
$CMD &
riverctl set-focused-tags "$TAG"

