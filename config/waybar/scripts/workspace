#!/bin/sh

case "$1" in
  status)
    id="$2"
    label="$3"
    active_id=$(hyprctl -j activeworkspace | jq -r '.id')

    if [ "$active_id" = "$id" ]; then
      printf '{"text":"%s","class":"active"}\n' "$label"
    else
      printf '{"text":"%s"}\n' "$label"
    fi
    ;;
  switch)
    id="$2"
    hyprctl dispatch "hl.dsp.focus({ workspace = $id })"
    pkill -RTMIN+8 waybar
    ;;
esac
