{
    "layer": "top",
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-right": ["battery", "cpu", "memory", "pulseaudio", "clock"],

    "clock": {
        "format": " {:%H:%M}"
    },

    "cpu": {
        "format": " {usage}%"
    },

    "memory": {
        "format": " {used}/{total}GiB"
    },

    "pulseaudio": {
        "format": "  {volume}%",
        "format-muted": "",
        "on-click": "pavucontrol"
    }
}
