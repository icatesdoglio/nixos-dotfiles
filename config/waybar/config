{
    "layer": "top",
    "modules-left": [
        "custom/ws1",
        "custom/ws2",
        "custom/ws3",
        "custom/ws4",
        "custom/ws5",
        "custom/ws6",
        "custom/ws7",
        "custom/ws8",
        "custom/ws9",
        "custom/ws10",
        "hyprland/window"
    ],
    "modules-right": ["custom/network", "battery", "cpu", "custom/mem-cust", "pulseaudio", "clock"],

    "custom/ws1":  { "exec": "~/.config/waybar/scripts/workspace status 1 1",  "on-click": "~/.config/waybar/scripts/workspace switch 1",  "return-type": "json", "interval": 2, "signal": 8, "tooltip": false },
    "custom/ws2":  { "exec": "~/.config/waybar/scripts/workspace status 2 2",  "on-click": "~/.config/waybar/scripts/workspace switch 2",  "return-type": "json", "interval": 2, "signal": 8, "tooltip": false },
    "custom/ws3":  { "exec": "~/.config/waybar/scripts/workspace status 3 3",  "on-click": "~/.config/waybar/scripts/workspace switch 3",  "return-type": "json", "interval": 2, "signal": 8, "tooltip": false },
    "custom/ws4":  { "exec": "~/.config/waybar/scripts/workspace status 4 4",  "on-click": "~/.config/waybar/scripts/workspace switch 4",  "return-type": "json", "interval": 2, "signal": 8, "tooltip": false },
    "custom/ws5":  { "exec": "~/.config/waybar/scripts/workspace status 5 5",  "on-click": "~/.config/waybar/scripts/workspace switch 5",  "return-type": "json", "interval": 2, "signal": 8, "tooltip": false },
    "custom/ws6":  { "exec": "~/.config/waybar/scripts/workspace status 6 6",  "on-click": "~/.config/waybar/scripts/workspace switch 6",  "return-type": "json", "interval": 2, "signal": 8, "tooltip": false },
    "custom/ws7":  { "exec": "~/.config/waybar/scripts/workspace status 7 7",  "on-click": "~/.config/waybar/scripts/workspace switch 7",  "return-type": "json", "interval": 2, "signal": 8, "tooltip": false },
    "custom/ws8":  { "exec": "~/.config/waybar/scripts/workspace status 8 8",  "on-click": "~/.config/waybar/scripts/workspace switch 8",  "return-type": "json", "interval": 2, "signal": 8, "tooltip": false },
    "custom/ws9":  { "exec": "~/.config/waybar/scripts/workspace status 9 9",  "on-click": "~/.config/waybar/scripts/workspace switch 9",  "return-type": "json", "interval": 2, "signal": 8, "tooltip": false },
    "custom/ws10": { "exec": "~/.config/waybar/scripts/workspace status 10 0", "on-click": "~/.config/waybar/scripts/workspace switch 10", "return-type": "json", "interval": 2, "signal": 8, "tooltip": false },


    "custom/network": {
        "exec": "~/.config/waybar/scripts/network",
        "interval": 3,
        "return-type": "json"
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%"
    },

    "clock": {
        "format": " {:%H:%M}"
    },

    "cpu": {
        "format": " {usage}%"
    },

    "custom/mem-cust": {
        "exec": "~/.config/waybar/scripts/custom-memory",
        "interval": 3
    },

    "pulseaudio": {
        "format": "  {volume}%",
        "format-muted": "",
        "on-click": "~/.config/waybar/scripts/window", 
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +1%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -1%",
        "tooltip": false
    }
}
